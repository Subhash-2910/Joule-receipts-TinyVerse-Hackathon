# Cloud sync server for the demo: standard library only, so the image is just python:slim + our package.
FROM python:3.12-slim
WORKDIR /app
COPY joule/ ./joule/
ENV PYTHONUNBUFFERED=1 PORT=8787 JOULE_CLOUD_DB=/data/cloud.db
EXPOSE 8787
VOLUME ["/data"]
HEALTHCHECK --interval=10s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8787/health', timeout=2)"
CMD ["python", "-m", "joule.sync.server"]
